# Copy this file to ".env" for local testing (vercel dev),
# and set the same variables in the Vercel dashboard for production.

# --- SMTP server (the mailbox that SENDS the email) ---
# Gmail example (recommended: use an App Password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-char-app-password

# From address shown on the email (optional; defaults to SMTP_USER)
MAIL_FROM=your-sending-account@gmail.com

# --- Where complaints are delivered ---
MAIL_TO=support@vintagefinance.in

# --- Where loan enquiries (/api/send-lead) are delivered (optional; defaults to MAIL_TO) ---
LEADS_MAIL_TO=

# --- CORS: your live website origin (use * only for testing) ---
# e.g. https://www.vintagefinance.in
ALLOWED_ORIGIN=*

# Optional, /api/send-lead only: several allowed origins, comma-separated
# e.g. https://www.vintagefinance.in,https://vintage-fin--staging-xxxx.web.app
ALLOWED_ORIGINS=
